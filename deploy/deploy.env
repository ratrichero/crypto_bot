# Cau hinh deploy (KHONG chua secret, duoc commit) - file cau hinh duy nhat.
# Duong dan tuong doi tinh tu goc repo.
# git up deploy nhanh dang checkout; doi nhanh: git up --branch X.

DEPLOY_REMOTE=origin

# App quan ly bang pm2, theo thu tu restart (app tien that de cuoi).
APPS=muse-dashboard muse-radar muse-live-equity muse-live-trader muse-binance

# Python chay app (phai trung ExecStart cua systemd cu - doctor kiem tra).
# Dashboard + Binance: .venv chung o goc repo; meme-radar co .venv rieng.
PYTHON=.venv/bin/python
PYTHON_MUSE_RADAR=meme-radar/.venv/bin/python
PYTHON_MUSE_LIVE_TRADER=meme-radar/.venv/bin/python
PYTHON_MUSE_LIVE_EQUITY=meme-radar/.venv/bin/python

# File KEY=VALUE nap vao moi app luc start (thay EnvironmentFile cua systemd):
# BINANCE_API_KEY/SECRET, DATABASE_URL... Rong = khong nap.
# Ghi de rieng tung app: ENV_FILE_MUSE_LIVE_TRADER=meme-radar/.env
# (rong = dung ENV_FILE chung, "-" = khong nap file nao).
# Nhieu file: cach nhau dau cach, file TRUOC duoc uu tien (bien da co khong bi
# ghi de), vd ENV_FILE_MUSE_LIVE_TRADER=meme-radar/.env .env
ENV_FILE=.env

# Migrate DB: file SQL idempotent (CREATE/ALTER ... IF NOT EXISTS) duoc ap
# dung khi doi, TRUOC khi restart app; loi -> khong restart app nao.
# Rong = tat. Nhieu file: cach nhau dau cach.
MIGRATE_SQL=db/schema.sql
# Bien chua URL Postgres: lay tu moi truong, roi MIGRATE_ENV_FILE (rong = ENV_FILE)
MIGRATE_DB_ENV=DATABASE_URL
MIGRATE_ENV_FILE=
# Python chay migrate (can psycopg). Rong = PYTHON
MIGRATE_PYTHON=

# Dashboard Streamlit
DASHBOARD_PORT=8501
DASHBOARD_ADDRESS=0.0.0.0
DASHBOARD_ARGS=

# Log pm2 (pm2-logrotate, cai bang: git up setup)
LOGROTATE_MAX_SIZE=20M
LOGROTATE_RETAIN=10
