{
  "_comment": [
    "Dinh nghia app chay duoi pm2 - dung chung cho deploy.py va ecosystem.config.js.",
    "Ten app = ten service systemd cu (muse-*) de tab Monitor/thoi quen khong doi.",
    "cwd/entry/search_path tinh tu goc repo. search_path = thu muc ma app import",
    "module (sys.path) -> deploy.py tinh tap file Python app phu thuoc de biet",
    "commit moi co dong toi app hay khong. {VAR} lay tu deploy.env.",
    "live=true: app giao dich tien that - git up gan nhan [tien that] va in tom",
    "tat state truoc khi restart (khong hoi y/N, tu restart nhu app khac).",
    "kill_timeout (ms): thoi gian cho bot dung sach (lam xong vong/swap dang chay)."
  ],
  "apps": {
    "muse-dashboard": {
      "label": "Dashboard",
      "cwd": "dashboard",
      "entry": "app.py",
      "python_args": ["-m", "streamlit", "run", "app.py",
                      "--server.port", "{DASHBOARD_PORT}",
                      "--server.address", "{DASHBOARD_ADDRESS}",
                      "--server.headless", "true"],
      "extra_args_var": "DASHBOARD_ARGS",
      "search_path": ["dashboard", "db", "binance-bot"],
      "requirements": ["dashboard/requirements.txt"],
      "live": false,
      "kill_timeout": 10000,
      "health_seconds": 15
    },
    "muse-radar": {
      "label": "Radar paper (Solana)",
      "cwd": "meme-radar",
      "entry": "radar.py",
      "search_path": ["meme-radar"],
      "requirements": ["meme-radar/requirements.txt"],
      "live": false,
      "kill_timeout": 30000,
      "health_seconds": 20
    },
    "muse-live-trader": {
      "label": "Live Trader (Solana tien that)",
      "cwd": "meme-radar",
      "entry": "live_trader.py",
      "search_path": ["meme-radar"],
      "requirements": ["meme-radar/requirements.txt"],
      "live": true,
      "kill_timeout": 180000,
      "health_seconds": 30
    },
    "muse-binance": {
      "label": "Binance Futures LIVE",
      "cwd": "binance-bot",
      "entry": "binance_bot.py",
      "search_path": ["binance-bot", "db"],
      "requirements": ["binance-bot/requirements.txt"],
      "live": true,
      "kill_timeout": 60000,
      "health_seconds": 45,
      "state_file": "binance-bot/state.json"
    },
    "muse-live-equity": {
      "label": "Equity vi live (Solana, snapshot 15s)",
      "cwd": "meme-radar",
      "entry": "live_equity_snap.py",
      "search_path": ["meme-radar"],
      "requirements": ["meme-radar/requirements.txt"],
      "live": false,
      "kill_timeout": 5000,
      "health_seconds": 20
    }
  }
}
